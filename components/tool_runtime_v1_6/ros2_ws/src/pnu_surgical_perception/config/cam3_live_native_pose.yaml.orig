/**:
  ros__parameters:
    # CAM3 only. Its depth-to-color transform must arrive on its own latched
    # topic after measurement; no CAM4 transform is copied into this profile.
    camera: "cam_3"
    rgb_topic: "/synced/cam_3/color/image_raw/compressed"
    color_camera_info_topic: "/synced/cam_3/color/camera_info"
    depth_topic: "/synced/cam_3/depth/image_rect_raw/compressedDepth"
    depth_camera_info_topic: "/synced/cam_3/depth/camera_info"
    extrinsics_topic: "/synced/cam_3/extrinsics/depth_to_color"
    require_depth: true
    require_extrinsics_topic: true
    maximum_stamp_delta_ns: 1000000
    sync_queue_size: 8
    latest_frame_only: true

    pose_topic: "/perception/cam_3/tool/poses"
    observation_topic: "/perception/cam_3/tool/observations"
    overlay_topic: "/perception/cam_3/tool/overlay/compressed"
    pose_overlay_topic: "/perception/cam_3/tool/pose_overlay/compressed"
    diagnostics_topic: "/perception/cam_3/tool/diagnostics"
    health_topic: "/perception/cam_3/tool/health"
    view: "cam_3"

    confidence_threshold: 0.3
    enable_class_agnostic_nms: true
    class_agnostic_nms_iou: 0.8
    pose_axis_length_m: 0.05
    optimize_for_inference: true
    jit_compile: true
    fp16: true
    jpeg_quality: 90

    # Confirm from CAM3's sensor; this keeps any 3D result non-operational.
    depth_scale_m_per_unit: 0.001
    depth_scale_verified: false
    minimum_depth_m: 0.05
    maximum_depth_m: 10.0
    depth_to_color_rotation_convention: "column_major"
    minimum_depth_to_color_baseline_m: 0.02
    maximum_depth_to_color_baseline_m: 0.12
    expected_depth_to_color_translation_direction: [-1.0, 0.0, 0.0]
    minimum_depth_to_color_direction_cosine: 0.95
    depth_to_color_rotation_orthonormal_tolerance: 0.0001
    depth_to_color_rotation_determinant_tolerance: 0.0001
    expected_color_frame: "cam_3_color_optical_frame"
    expected_depth_frame: "cam_3_depth_optical_frame"
    calibration_version: "cam3_live_topic_provisional_pending_measurement"

    # CAM3 plane is intentionally not borrowed from CAM4. It is marked
    # provisional so the node degrades any metric output until measured.
    support_plane_normal: [0.0, 0.0, -1.0]
    support_plane_offset_m: 0.0
    support_plane_config_version: "cam3_support_plane_provisional_pending_measurement"
    support_plane_inlier_ratio: 0.0
    support_plane_residual_p95_m: 0.0
