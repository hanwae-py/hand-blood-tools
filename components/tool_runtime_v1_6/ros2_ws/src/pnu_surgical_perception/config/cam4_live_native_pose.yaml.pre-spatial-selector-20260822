/**:
  ros__parameters:
    # CAM4 only: RGB + native depth are registered locally with the latched
    # RealSense depth-to-color calibration topic. Do not use aligned depth.
    camera: "cam_4"
    rgb_topic: "/synced/cam_4/color/image_raw/compressed"
    color_camera_info_topic: "/synced/cam_4/color/camera_info"
    depth_topic: "/synced/cam_4/depth/image_rect_raw/compressedDepth"
    depth_camera_info_topic: "/synced/cam_4/depth/camera_info"
    extrinsics_topic: "/synced/cam_4/extrinsics/depth_to_color"
    require_depth: true
    require_extrinsics_topic: true
    maximum_stamp_delta_ns: 1000000
    sync_queue_size: 8
    latest_frame_only: true

    pose_topic: "/perception/cam_4/tool/poses"
    observation_topic: "/perception/cam_4/tool/observations"
    overlay_topic: "/perception/cam_4/tool/overlay/compressed"
    pose_overlay_topic: "/perception/cam_4/tool/pose_overlay/compressed"
    diagnostics_topic: "/perception/cam_4/tool/diagnostics"
    health_topic: "/perception/cam_4/tool/health"
    view: "cam_4"

    confidence_threshold: 0.3
    enable_class_agnostic_nms: true
    class_agnostic_nms_iou: 0.8
    pose_axis_length_m: 0.05
    optimize_for_inference: true
    jit_compile: true
    fp16: true
    jpeg_quality: 90

    # Approved against CAM4 serial 146222251000's factory Depth Units and the
    # live /synced depth-to-colour Extrinsics relay (2026-08-22).
    depth_scale_m_per_unit: 0.001
    depth_scale_verified: true
    minimum_depth_m: 0.05
    maximum_depth_m: 10.0

    # The reference is source documentation only; it is never a runtime
    # fallback. Values are the direct `Extrinsics.rotation` vector and are
    # explicitly column-major as specified by librealsense.
    depth_to_color_rotation_convention: "column_major"
    depth_to_color_rotation:
      - 0.9999935626983643
      - -0.0015063914470374584
      - -0.0032486612908542156
      - 0.0014905486023053527
      - 0.999987006187439
      - -0.004873663652688265
      - 0.003255960764363408
      - 0.004868790041655302
      - 0.9999828338623047
    depth_to_color_translation_m:
      - -0.059281326830387115
      - -0.000027586851501837373
      - 0.00048295879969373345
    minimum_depth_to_color_baseline_m: 0.02
    maximum_depth_to_color_baseline_m: 0.12
    expected_depth_to_color_translation_direction: [-1.0, 0.0, 0.0]
    minimum_depth_to_color_direction_cosine: 0.95
    depth_to_color_rotation_orthonormal_tolerance: 0.0001
    depth_to_color_rotation_determinant_tolerance: 0.0001
    expected_color_frame: "cam_4_color_optical_frame"
    expected_depth_frame: "cam_4_depth_optical_frame"
    calibration_version: "cam4_live_factory_depth_scale_and_workplane_20260822"

    # CAM4 live work plane. The AprilGrid board top was fit from native depth
    # registered into RGB with factory extrinsics, then shifted 10 mm away
    # from the camera to compensate the measured board thickness.
    support_plane_normal:
      - 0.16141088206958792
      - 0.008033494407223672
      - -0.9868545942118964
    support_plane_offset_m: 0.833650819118987
    support_plane_config_version: "cam4_live_aprilgrid_depth_workplane_20260822"
    support_plane_inlier_ratio: 0.9955357142857143
    support_plane_residual_p95_m: 0.0038287521465830998

    # Dynamic /tf uses the existing constrained quaternion: translation and
    # yaw are observed; roll/pitch are completed from the support-plane normal.
    # ToolPoseArray remains PLANAR_4DOF_WITH_NORMAL_PRIOR.
    publish_tool_tf: true
    tf_stale_after_sec: 2.0
    tf_max_future_sec: 0.5
    # Dynamic child frames are temporal 3-D tracks, never frame-local NMS IDs.
    # A large jump is rejected until the old track expires rather than creating
    # a false extra frame in /tf.
    tf_track_max_displacement_m: 0.10
    tf_track_ttl_sec: 5.0
    tf_track_max_active_per_class: 8
    tf_track_reset_stamp_jump_sec: 5.0
