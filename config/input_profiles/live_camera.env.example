# Live VIPLab CAM4: subscribe 1:1 to /synced/cam_4 (reliable / volatile / KEEP_LAST 20).
# Set ROS_DOMAIN_ID/RMW/discovery according to the camera PC.
export COLOR_TOPIC=/synced/cam_4/color/image_raw/compressed
export COLOR_CAMERA_INFO_TOPIC=/synced/cam_4/color/camera_info
export DEPTH_TOPIC=/synced/cam_4/depth/image_rect_raw/compressedDepth
export DEPTH_CAMERA_INFO_TOPIC=/synced/cam_4/depth/camera_info
