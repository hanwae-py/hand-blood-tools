# Offline RGB/H5 test mode (used by fake_camera_publisher).
export OFFLINE_RGB_PATH="$HOME/data/cam4_rgb.avi"
export OFFLINE_DEPTH_H5_PATH="$HOME/data/cam4_depth_raw.h5"
export OFFLINE_CALIB_PATH="$HOME/data/cam4_calibration.json"
export OFFLINE_CAM_KEY=cam_4
export OFFLINE_RATE_HZ=15.0

# The fake publisher provides raw ROS Image messages.
export COLOR_TOPIC=/camera/color/image_raw
export COLOR_CAMERA_INFO_TOPIC=/camera/color/camera_info
export DEPTH_TOPIC=/camera/aligned_depth_to_color/image_raw
export DEPTH_CAMERA_INFO_TOPIC=/camera/color/camera_info
export COLOR_TRANSPORT=raw
export DEPTH_TRANSPORT=raw
