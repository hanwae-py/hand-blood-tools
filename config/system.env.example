# Copy this file to config/system.env and set paths for this PC only.
export ROS_DISTRO=jazzy
export ROS_DOMAIN_ID=0
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Conda interpreters on this PC. Do not activate these envs in the ROS build shell.
export HAND_PYTHON="$(conda info --base)/envs/hand/bin/python"
export RFDETR_PYTHON="$(conda info --base)/envs/rfdetr/bin/python"

# Large external assets; keep them outside this portable source bundle.
# Select one Tool model at runtime. TOOL_CHECKPOINT remains the legacy Small
# fallback so existing local system.env files continue to work.
export TOOL_MODEL_SIZE=small
export TOOL_CHECKPOINT="$HOME/models/cam4_rfdetr_seg_small_regular_resume_best.pth"
export TOOL_CHECKPOINT_SMALL="$HOME/models/cam4_rfdetr_seg_small_regular_resume_best.pth"
export TOOL_CHECKPOINT_MEDIUM="$HOME/models/medium_best.pth"
export TOOL_CHECKPOINT_LARGE="$HOME/models/large_best.pth"
export TOOL_CHECKPOINT_XLARGE="$HOME/models/checkpoint_selected_external_0825_holdout_conf030.pth"
# Optional global override. If unset, every model uses 0.30.
# export TOOL_CONFIDENCE_THRESHOLD=0.30
# Select a calibrated camera-view ROI profile for live ROS processing.
# Keep none until the current installation has its own measured profile.
export TOOL_ROI_PROFILE=none
export BLOOD_CHECKPOINT="$HOME/models/blood_detection.pth"
export MCAP_PATH="$HOME/data/multicam_cam4.mcap"

# VIPLab source topics. Ingress is the only /synced subscriber; workers
# read /perception/ingress/cam_4/... (see scripts/select_cam.sh).
# QoS: reliable / volatile / KEEP_LAST 20.
export COLOR_TOPIC=/synced/cam_4/color/image_raw/compressed
export COLOR_CAMERA_INFO_TOPIC=/synced/cam_4/color/camera_info
export DEPTH_TOPIC=/synced/cam_4/depth/image_rect_raw/compressedDepth
export DEPTH_CAMERA_INFO_TOPIC=/synced/cam_4/depth/camera_info
export EXTRINSICS_TOPIC=/synced/cam_4/extrinsics/depth_to_color
export COLOR_TRANSPORT=compressed
export DEPTH_TRANSPORT=compressed_depth
