[Unit]
Description=Taskplanner perception-only CAM4 palm pose transform
Documentation=file://%h/projects/hand-blood-tools/scripts/run_cam4_palm_pose.sh
Requires=taskplanner-perception-cam4-ingress.service
After=taskplanner-perception-cam4-ingress.service
PartOf=taskplanner-perception-cam4-ingress.service
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_cam4_palm_pose.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=local-fast
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_local_fast.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_cam4_palm_pose.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=taskplanner-perception-stack.target
