[Unit]
Description=Taskplanner 2x2 CAM3 CAM4 CAM1 FLIR operator overlay
Documentation=file://%h/projects/hand-blood-tools/scripts/run_operator_quad.sh
Requires=taskplanner-perception-ingress.service
After=taskplanner-perception-final-overlay.service taskplanner-perception-hand-cam1-ingress.service taskplanner-perception-blood-flir-ingress.service taskplanner-perception-hand-fusion.service
PartOf=taskplanner-perception-ingress.service
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_operator_quad.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=mtu-safe
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_mtu_safe.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_operator_quad.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=taskplanner-perception-stack.target
