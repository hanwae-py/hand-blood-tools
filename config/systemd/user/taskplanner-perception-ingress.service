[Unit]
Description=Taskplanner perception ingress (CAM1 CAM3 CAM4 FLIR local fan-out)
Documentation=file://%h/projects/hand-blood-tools/scripts/run_perception_ingress.sh
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_perception_ingress.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
# These are intentionally scoped to this perception unit.  The runner repeats
# them after loading config/system.env so no robot/control service is changed.
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=local-fast
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_local_fast.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_perception_ingress.sh all
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=taskplanner-perception-stack.target
