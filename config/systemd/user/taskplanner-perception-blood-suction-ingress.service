[Unit]
Description=Taskplanner suction-camera Blood perception
Documentation=file://%h/projects/hand-blood-tools/scripts/run_blood_cam4.sh
After=taskplanner-perception-suction-ingress.service
Wants=taskplanner-perception-suction-ingress.service
PartOf=taskplanner-perception-stack.target
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_blood_cam4.sh
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=local-fast
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_local_fast.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_blood_cam4.sh suction -p autostart:=true
Restart=always
RestartSec=8
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=taskplanner-perception-stack.target
