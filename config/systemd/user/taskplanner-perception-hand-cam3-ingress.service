[Unit]
Description=Taskplanner CAM3 RGB-D Hand perception from local ingress
Documentation=file://%h/projects/hand-blood-tools/scripts/run_hand_cam4.sh
Requires=taskplanner-perception-ingress.service
After=taskplanner-perception-ingress.service
PartOf=taskplanner-perception-ingress.service
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_hand_cam4.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=local-fast
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_local_fast.xml
Environment=PYTHONUNBUFFERED=1
Environment=PNU_DEPTH_REGISTRATION_CUDA_LIBRARY=/home/pnucvlab/opt/pnu-depth-registration-cuda-0.1.0-cuda12.8-sm86/lib/libpnu_depth_registration_cuda.so.1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_hand_cam4.sh cam_3 -p autostart:=true
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=45

[Install]
WantedBy=taskplanner-perception-stack.target
