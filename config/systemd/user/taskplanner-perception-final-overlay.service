[Unit]
Description=Taskplanner final CAM3 CAM4 structured Debug overlay
Documentation=file://%h/projects/hand-blood-tools/scripts/run_final_overlay.sh
After=taskplanner-perception-ingress.service taskplanner-perception-cam4-ingress.service
PartOf=taskplanner-perception-ingress.service
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_final_overlay.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=mtu-safe
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_mtu_safe.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_final_overlay.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=taskplanner-perception-stack.target
