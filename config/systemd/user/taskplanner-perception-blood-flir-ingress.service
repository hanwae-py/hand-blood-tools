[Unit]
Description=Taskplanner FLIR Blood perception from local RGB ingress
Documentation=file://%h/projects/hand-blood-tools/scripts/run_blood_cam4.sh
Requires=taskplanner-perception-ingress.service
After=taskplanner-perception-ingress.service
PartOf=taskplanner-perception-ingress.service
ConditionPathExists=%h/projects/hand-blood-tools/scripts/run_blood_cam4.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/hand-blood-tools
Environment=ROS_DOMAIN_ID=0
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=PERCEPTION_DDS_PROFILE=local-fast
Environment=CYCLONEDDS_URI=file://%h/projects/hand-blood-tools/config/cyclonedds_perception_local_fast.xml
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/bash %h/projects/hand-blood-tools/scripts/run_blood_cam4.sh flir -p autostart:=true
Restart=always
RestartSec=8
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=taskplanner-perception-stack.target
